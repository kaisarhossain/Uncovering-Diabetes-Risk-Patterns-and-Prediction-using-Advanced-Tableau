      <column caption='Risk Cluster' datatype='string' name='[Calculation_608619271967342606]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 35&#10;   AND [bmi] &lt; 22&#10;   AND [glucose_fasting] &lt; 110&#10;   AND [insulin_level] &lt; 15&#10;   AND [diabetes_risk_score] &lt; 30 THEN&#10;    &quot;Low Risk&quot;&#10;&#10;ELSEIF [age] &lt; 55&#10;   AND [bmi] &lt; 28&#10;   AND [glucose_fasting] &lt; 140&#10;   AND [insulin_level] &lt; 30&#10;   AND [diabetes_risk_score] &lt; 60 THEN&#10;    &quot;Moderate Risk&quot;&#10;&#10;ELSE&#10;    &quot;High Risk&quot;&#10;END' />
