        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &apos;Underweight&apos;&#10;ELSEIF [bmi] &lt; 25 THEN &apos;Normal&apos;&#10;ELSEIF [bmi] &lt; 30 THEN &apos;Overweight&apos;&#10;ELSEIF [bmi] &lt; 40 THEN &apos;Obese&apos;&#10;ELSE &apos;Morbidly Obese&apos;&#10;END' />
