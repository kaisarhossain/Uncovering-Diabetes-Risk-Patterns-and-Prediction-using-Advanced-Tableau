    <worksheet name='Physical Activity &amp; Hypertension'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='diabetes_dataset' name='federated.17t43e21kp2bpb1b3aw431hty10h' />
          </datasources>
          <datasource-dependencies datasource='federated.17t43e21kp2bpb1b3aw431hty10h'>
            <column caption='Hypertension Category' datatype='string' name='[Calculation_608619271533363205]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [systolic_bp] &gt;= 140 OR [diastolic_bp] &gt;= 90 THEN &apos;Hypertensive&apos;&#10;ELSEIF [systolic_bp] &gt;= 130 OR [diastolic_bp] &gt;= 80 THEN &apos;Elevated&apos;&#10;ELSE &apos;Normal&apos;&#10;END' />
