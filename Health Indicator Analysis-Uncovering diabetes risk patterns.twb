        <calculation class='tableau' formula='IF [age] &lt; 40 THEN &apos;&lt;40: Young Adult&apos;&#10;ELSEIF [age] &lt;= 59 THEN &apos;40-59: Middle-Aged&apos;&#10;ELSEIF [age] &lt;= 74 THEN &apos;60-74: Young-Old&apos;&#10;ELSE &apos;75+: Oldest-Old&apos;&#10;END' />
