    <worksheet name='Gauge - Probability'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='diabetes_dataset' name='federated.17t43e21kp2bpb1b3aw431hty10h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Parameter Hba1C' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='1.2'>
              <calculation class='tableau' formula='1.2' />
            </column>
            <column caption='Parameter Glucose Postprandial' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='110.'>
              <calculation class='tableau' formula='110.' />
            </column>
            <column caption='Parameter Glucose Fasting' datatype='real' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='50.'>
              <calculation class='tableau' formula='50.' />
            </column>
            <column caption='Parameter Family History' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yes&quot;'>
              <calculation class='tableau' formula='&quot;Yes&quot;' />
            </column>
            <column caption='Parameter Age' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='45'>
              <calculation class='tableau' formula='45' />
            </column>
            <column caption='Parameter Physical Activity Min per Week' datatype='integer' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='40'>
              <calculation class='tableau' formula='40' />
            </column>
            <column caption='Parameter BMI' datatype='real' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='35.'>
              <calculation class='tableau' formula='35.' />
            </column>
            <column caption='Parameter Systolic BP' datatype='real' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='128.'>
              <calculation class='tableau' formula='128.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17t43e21kp2bpb1b3aw431hty10h'>
            <column caption='Predicted Probability (Individual)' datatype='real' name='[Calculation_1141873618587721732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SCRIPT_REAL(&#10;&quot;&#10;result = tabpy.query(&#10;    &apos;predict_diabetes&apos;,&#10;    _arg1, _arg2, _arg3, _arg4,&#10;    _arg5, _arg6, _arg7, _arg8&#10;)[&apos;response&apos;]&#10;&#10;return result[&apos;probs&apos;]&#10;&quot;,&#10; ATTR([Parameters].[Parameter 1]),&#10; ATTR([Parameters].[Parameter 2]),&#10; ATTR([Parameters].[Parameter 3]),&#10; ATTR([Parameters].[Parameter 4]),&#10; ATTR([Parameters].[Parameter 5]),&#10; ATTR([Parameters].[Parameter 6]),&#10; ATTR([Parameters].[Parameter 7]),&#10; ATTR([Parameters].[Parameter 8])&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Gauge Value (numeric)' datatype='real' name='[Calculation_3318097400550260739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([Calculation_1141873618587721732])*100)'>
                <table-calc ordering-type='Rows' />
